# Copy to .env and adjust. `set -a; source .env; set +a` exports every line.
# These values match the Postgres service in docker-compose.yml.

# Required
DATABASE_URL=postgres://todo:todo@localhost:5432/todo?sslmode=disable
JWT_SECRET=local-dev-secret-please-change

# Optional (defaults shown)
JWT_TTL=24h
PORT=8080
# Browser origins allowed to call the API (comma-separated). Defaults cover
# Vite (5173) and CRA (3000) dev servers. Use "*" to allow any origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
